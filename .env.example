# Docker Compose ファイルのパス（プロジェクトルートから実行するための設定）
COMPOSE_FILE=infra/compose/docker-compose.yml

# フロントエンドコンテナの Node.js バージョン（20 以上が必要。Vite 8 / Vitest 3 が Node.js 18 非対応）
# 変更後は docker compose up --build で再ビルドが必要
NODE_VERSION=20

# ローカル開発用DB設定
DB_NAME=skilize
DB_USER=skilize
DB_PASSWORD=password

# JWT設定
JWT_SECRET=change-this-to-a-random-256-bit-secret-key-before-use
JWT_EXPIRATION_MS=86400000

# CORS（フロントエンドのオリジン）
FRONTEND_ORIGIN=http://localhost:8081,http://localhost:5173

# Spring（本番では prod に変更）
SPRING_PROFILES_ACTIVE=local

# テストデータの投入（tl01/user01/user02 を DB に挿入する）
# true にするとテストユーザーが追加される。本番の通常運用は false。
# ※ 一度 true で起動したあと false に戻してもテストデータは削除されない（手動削除が必要）
LOAD_TEST_DATA=false

# ─── AI Module ────────────────────────────────────
# AI機能の有効化（false にすると LLM 呼び出しが行われずコストが発生しない）
AI_ENABLED=true

# LLM プロバイダー設定（openai または anthropic）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI を使う場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=

# Anthropic を使う場合（LLM_PROVIDER=anthropic）
ANTHROPIC_API_KEY=

# 内部通信認証キー（ランダムな文字列を設定）
AI_SECRET_KEY=change-this-to-a-random-secret

# Spring Boot → AI サービス URL（通常変更不要）
AI_SERVICE_URL=http://ai:8000

# ─── 社内CA証明書設定（証明書が不要な場合はコメントのままにする）────────────────
# 社内プロキシが SSL インスペクションを行う環境では true に設定する
# true にする場合は infra/certs/company-root-ca.cer に証明書を配置してから --build で再起動する
CA_CERT_ENABLED=false

# ─── 社内プロキシ設定（プロキシ不要の場合はコメントのままにする）────────────────
# HTTP_PROXY=http://proxy.corp.example.com:8080
# HTTPS_PROXY=http://proxy.corp.example.com:8080
# NO_PROXY=localhost,127.0.0.1,db,backend,frontend,ai
#
# Java（Gradle / Spring Boot）は HTTP_PROXY 環境変数を読まないため、
# JAVA_TOOL_OPTIONS で JVM プロキシシステムプロパティを個別に指定する。
# nonProxyHosts の区切りは | を使用すること（, ではなく）。
# JAVA_TOOL_OPTIONS=-Dhttp.proxyHost=proxy.corp.example.com -Dhttp.proxyPort=8080 -Dhttps.proxyHost=proxy.corp.example.com -Dhttps.proxyPort=8080 -Dhttp.nonProxyHosts="localhost|127.0.0.1|db|backend|frontend|ai"
