# Docker Compose ファイルのパス（プロジェクトルートから実行するための設定）
COMPOSE_FILE=infra/compose/docker-compose.yml

# ローカル開発用DB設定
DB_NAME=skilize
DB_USER=skilize
DB_PASSWORD=password

# JWT設定
JWT_SECRET=change-this-to-a-random-256-bit-secret-key-before-use
JWT_EXPIRATION_MS=86400000

# CORS（フロントエンドのオリジン）
FRONTEND_ORIGIN=http://localhost:8081,http://localhost:5173

# Spring（本番では prod に変更）
SPRING_PROFILES_ACTIVE=local

# ─── AI Module ────────────────────────────────────
# AI機能の有効化（false にすると LLM 呼び出しが行われずコストが発生しない）
AI_ENABLED=true

# LLM プロバイダー設定（openai または anthropic）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# OpenAI を使う場合（LLM_PROVIDER=openai）
OPENAI_API_KEY=

# Anthropic を使う場合（LLM_PROVIDER=anthropic）
ANTHROPIC_API_KEY=

# 内部通信認証キー（ランダムな文字列を設定）
AI_SECRET_KEY=change-this-to-a-random-secret

# Spring Boot → AI サービス URL（通常変更不要）
AI_SERVICE_URL=http://ai:8000
